# Copy this file to .env and fill in the values:  cp .env.example .env

# --- Google Cloud (required for login, shelves and calendar) -------------------
# OAuth 2.0 client of type "Web application" with this authorized redirect URI:
#   https://localhost/steps
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key with the Google Books API enabled.
GOOGLE_API_KEY=

# Public address of the site. The OAuth redirect URI defaults to $PUBLIC_URL/steps;
# set GOOGLE_REDIRECT_URI to override it (it must match Google Cloud exactly).
PUBLIC_URL=https://localhost
# GOOGLE_REDIRECT_URI=https://localhost/steps

# --- Infrastructure (any values work; they are created on first start) --------
COUCHDB_USER=admin
COUCHDB_PASSWORD=change-me
RABBITMQ_USER=bookmaster
RABBITMQ_PASSWORD=change-me

# --- Welcome email (optional) --------------------------------------------------
# Gmail address + app password (https://myaccount.google.com/apppasswords).
# Leave empty to log emails in the mailer container instead of sending them.
MAIL_USER=
MAIL_PASSWORD=

# --- Optional tweaks -----------------------------------------------------------
# WEB_REPLICAS=3
# HTTP_PORT=80
# HTTPS_PORT=443
# TIME_ZONE=Europe/Rome
# PAGES_PER_DAY=15
